@startuml Appointment Creation Flow

actor User
participant ":Frontend" as Frontend
participant ":AppointmentController" as Controller
participant ":AppointmentService" as Service
participant ":AppointmentRepository" as AppointmentRepo
participant ":GroupMeetingRepository" as GroupRepo
participant ":ReminderService" as ReminderService

== Validation Phase ==

User -> Frontend: enter appointment details
Frontend -> Controller: validateAppointment(request, user)
Controller -> Service: validateAppointment(request, user)
activate Service

Service -> GroupRepo: findMatchingGroupMeeting(name, time)
GroupRepo --> Service: Optional<GroupMeeting>

alt Group Meeting Match Found
	Service --> Controller: GROUP_MEETING_MATCH response
	deactivate Service
	Controller --> Frontend: conflict response

	User -> Frontend: confirm join
	Frontend -> Controller: createAppointment(forceJoin=true)
	Controller -> Service: createAppointment(forceJoin=true)
	activate Service

	Service -> GroupRepo: findMatchingGroupMeeting()
	GroupRepo --> Service: GroupMeeting

	Service -> Service: addUserToGroupMeeting()
	note right: Skip if already participant

	Service -> GroupRepo: save(groupMeeting)

	Service --> Controller: AppointmentResponse
	deactivate Service
	Controller --> Frontend: appointment created

else No Group Meeting Match
	Service -> AppointmentRepo: findOverlappingAppointments(userId, time)
	AppointmentRepo --> Service: List<Appointment>

	alt Time Conflict Exists
		Service --> Controller: TIME_OVERLAP response
		deactivate Service
		Controller --> Frontend: conflict response

		alt User Chooses Replace
			User -> Frontend: confirm replace
			Frontend -> Controller: createAppointment(forceReplace=true)
			Controller -> Service: createAppointment(forceReplace=true)
			activate Service

			Service -> AppointmentRepo: findOverlappingAppointments()
			note right of Service: Recheck to prevent race condition
			AppointmentRepo --> Service: List<Appointment>

			group Transaction
				loop For each overlapping appointment
					alt Is GroupMeeting
						Service -> Service: removeUserFromGroupMeeting()
						Service -> GroupRepo: save(groupMeeting)
						note right: Or delete if no participants left
					else Is PersonalAppointment
						Service -> AppointmentRepo: delete(appointment)
					end
				end

				Service -> AppointmentRepo: save(newAppointment)

				opt Reminder requested
					Service -> ReminderService: createReminder(appointmentId, minutes)
				end
			end

			Service --> Controller: AppointmentResponse
			deactivate Service
			Controller --> Frontend: appointment created

		else User Cancels
			User -> Frontend: cancel
		end

	else No Conflicts
		Service --> Controller: validation success
		deactivate Service
		Controller --> Frontend: no conflicts

		User -> Frontend: click create
		Frontend -> Controller: createAppointment()
		Controller -> Service: createAppointment()
		activate Service

		Service -> AppointmentRepo: save(newAppointment)

		opt Reminder requested
			Service -> ReminderService: createReminder(appointmentId, minutes)
		end

		Service --> Controller: AppointmentResponse
		deactivate Service
		Controller --> Frontend: appointment created
	end
end

@enduml
