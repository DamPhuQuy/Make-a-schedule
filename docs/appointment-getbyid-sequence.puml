@startuml Get Appointment By ID

title Get Single Appointment Details

skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant "AppointmentController" as Controller
participant "AppointmentService" as Service
participant "Data Access Layer" as DAL

User -> Controller: GET /api/appointments/{id}
activate Controller

Controller -> Service: getAppointmentById(id, currentUser)
activate Service

Service -> DAL: findUser(userId)
activate DAL
DAL --> Service: User
deactivate DAL

Service -> DAL: findAppointmentById(id)
activate DAL
DAL --> Service: Appointment
deactivate DAL

alt [Found as normal appointment]
    Service -> Service: checkOwnership(appointment, user)

    Service -> DAL: findReminders(appointmentId)
    activate DAL
    DAL --> Service: List<Reminder>
    deactivate DAL

    Service -> Service: mapToResponse()

    Service --> Controller: AppointmentResponse
    deactivate Service
    Controller --> User: Success
    deactivate Controller

else [Not found, check group meeting]
    Service -> DAL: findGroupMeetingById(id)
    activate DAL
    DAL --> Service: GroupMeeting
    deactivate DAL

    Service -> Service: checkParticipation(groupMeeting, user)

    Service -> Service: mapToResponse()

    Service --> Controller: AppointmentResponse
    deactivate Service
    Controller --> User: Success
    deactivate Controller
end

@enduml
