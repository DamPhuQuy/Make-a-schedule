@startuml User Logout

title User Logout Flow

skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant "AuthController" as Controller
participant "AuthenticationService" as Service
participant "Data Access Layer" as DAL

User -> Controller: POST /api/auth/logout\n{refreshToken}
activate Controller

Controller -> Service: logout(refreshToken)
activate Service

Service -> DAL: deleteRefreshToken(token)
activate DAL
DAL --> Service: void
deactivate DAL

Service --> Controller: void
deactivate Service
Controller --> User: Success
deactivate Controller

note over User: Client deletes tokens from local storage

@enduml
