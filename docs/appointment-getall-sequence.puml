@startuml Get All Appointments

title Get All Appointments (Normal + Group Meetings)

skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant "AppointmentController" as Controller
participant "AppointmentService" as Service
participant "Data Access Layer" as DAL

User -> Controller: GET /api/appointments
activate Controller

Controller -> Service: getAllAppointments(currentUser)
activate Service

Service -> DAL: findUser(userId)
activate DAL
DAL --> Service: User
deactivate DAL

Service -> DAL: findUserAppointments(userId)
activate DAL
DAL --> Service: List<Appointment>
deactivate DAL

loop [For each appointment]
    Service -> DAL: findReminders(appointmentId)
    activate DAL
    DAL --> Service: List<Reminder>
    deactivate DAL

    Service -> Service: mapToResponse(appointment, reminders)
end

Service -> DAL: findUserGroupMeetings(userId)
activate DAL
DAL --> Service: List<GroupMeeting>
deactivate DAL

loop [For each group meeting]
    Service -> Service: mapToResponse(groupMeeting)
end

Service -> Service: combineResults()

Service --> Controller: List<AppointmentResponse>
deactivate Service
Controller --> User: Success
deactivate Controller

@enduml
