@startuml Authenticated Request

title Authenticated Request Flow (JWT Filter)

skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant "JwtAuthenticationFilter" as Filter
participant "JwtUtils" as JWT
participant "Data Access Layer" as DAL
participant "SecurityContext" as SecurityContext
participant "Controller" as Controller

User -> Filter: HTTP Request\nAuthorization: Bearer <token>
activate Filter

alt [Path is /api/auth/*]
    Filter -> Controller: Continue (skip filter)
    activate Controller
    Controller --> User: Response
    deactivate Controller
    deactivate Filter
else [Protected endpoint]
    Filter -> Filter: extractJWT()

    alt [No token]
        Filter -> Controller: Continue without auth
        activate Controller
        Controller --> User: 401 Unauthorized
        deactivate Controller
        deactivate Filter
    else [Token present]
        Filter -> JWT: extractEmail(token)
        activate JWT
        JWT --> Filter: email
        deactivate JWT

        Filter -> DAL: findUserByEmail(email)
        activate DAL
        DAL --> Filter: User
        deactivate DAL

        Filter -> JWT: isTokenValid(token, user)
        activate JWT
        JWT --> Filter: boolean
        deactivate JWT

        alt [Token valid]
            Filter -> SecurityContext: setAuthentication(user)
            activate SecurityContext
            deactivate SecurityContext

            Filter -> Controller: Continue with auth
            activate Controller
            Controller --> User: Success
            deactivate Controller
            deactivate Filter
        else [Token invalid]
            Filter -> Controller: Continue without auth
            activate Controller
            Controller --> User: 401 Unauthorized
            deactivate Controller
            deactivate Filter
        end
    end
end

@enduml
